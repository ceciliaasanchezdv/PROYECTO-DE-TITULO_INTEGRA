# Copiar a .env.cloud para las pruebas locales con Oracle Cloud.
# No subir el archivo privado ni copiar sus valores al repositorio.
PORT=3000
DB_USER=INTEGRA
DB_PASSWORD=CAMBIAR_POR_CLAVE_PRIVADA_DE_INTEGRA
# Usar la cadena TLS _low que aparece en Oracle Cloud, sin wallet.
DB_CONNECT_STRING=CADENA_TLS_LOW_DE_ORACLE_CLOUD
SESSION_SECRET=CAMBIAR_POR_UN_VALOR_ALEATORIO_LARGO
# Solo para preparar cuentas de demostracion; no subir valores reales.
SEED_SUPERVISOR_EMAIL=supervisor@integra.test
SEED_SUPERVISOR_PASSWORD=CAMBIAR
SEED_OPERADOR_EMAIL=operador@integra.test
SEED_OPERADOR_PASSWORD=CAMBIAR
